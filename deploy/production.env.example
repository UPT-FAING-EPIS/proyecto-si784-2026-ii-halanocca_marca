# Create /opt/cloudscope-automation/production.env on the VPS with chmod 600.
# Use the actual password of the existing PostgreSQL database.
DB_PASSWORD=replace-with-existing-database-password
CLOUDSCOPE_DOMAIN=169.58.156.169.nip.io
CLOUDSCOPE_HTTP_BIND=127.0.0.1:90
CLOUDSCOPE_HTTPS_BIND=443
# Verify this with docker inspect cloudscope-db before configuration.
TF_VAR_postgres_volume=cloudscope_cloudscope_pgdata
# Must match the existing com.docker.compose.project label.
COMPOSE_PROJECT_NAME=cloudscope
